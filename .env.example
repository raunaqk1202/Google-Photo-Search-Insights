# ========================
# Groq LLM
# ========================
GROQ_API_KEY=gsk_your_groq_api_key_here

# ========================
# Reddit — via Apify (no direct Reddit API needed)
# ========================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=discovery-engine/1.0

# ========================
# Apify (Reddit Scraper)
# ========================
APIFY_API_TOKEN=your_apify_api_token_here


# ========================
# YouTube Data API v3
# ========================
YOUTUBE_API_KEY=your_youtube_api_key

# ========================
# PostgreSQL
# ========================
POSTGRES_USER=discovery
POSTGRES_PASSWORD=discovery_secret
POSTGRES_DB=discovery_engine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://discovery:discovery_secret@postgres:5432/discovery_engine

# ========================
# Redis
# ========================
REDIS_URL=redis://redis:6379/0

# ========================
# Qdrant / ChromaDB
# ========================
QDRANT_URL=http://chromadb:8000
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ========================
# Embedding & Reranker Models
# ========================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ========================
# CORS (comma-separated origins)
# ========================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================
# App Settings
# ========================
APP_ENV=development
LOG_LEVEL=INFO
